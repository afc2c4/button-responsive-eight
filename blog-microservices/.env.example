# =============================================================================
# .env.example — modelo das variáveis de ambiente do projeto
# =============================================================================
# Como usar:
#   cp .env.example .env
#
# O arquivo .env com valores reais NUNCA deve ser commitado (ele está no
# .gitignore). Os valores abaixo servem apenas para desenvolvimento local.
#
# Regra: não escreva comentários na mesma linha de uma variável.
# Cada comentário fica numa linha própria.
# =============================================================================

# -----------------------------------------------------------------------------
# Geral
# -----------------------------------------------------------------------------
# Valores aceitos: development | test | production
NODE_ENV=development

# -----------------------------------------------------------------------------
# ms-users — Microsserviço de Usuários (dono da tabela de usuários)
# -----------------------------------------------------------------------------
# Porta HTTP em que o ms-users escuta
USERS_SERVICE_PORT=3001
# Arquivo SQLite que pertence SOMENTE ao ms-users (caminho relativo à pasta do serviço)
USERS_DB_PATH=./data/ms-users.sqlite
# Segredo usado para assinar os tokens JWT. Use no mínimo 32 caracteres.
# Em qualquer ambiente real, gere um valor aleatório e NUNCA use este exemplo.
JWT_SECRET=troque-este-valor-por-um-segredo-com-32-caracteres-ou-mais
# Validade do access token, em segundos (3600 = 1 hora)
JWT_EXPIRES_IN=3600

# -----------------------------------------------------------------------------
# ms-blog — Microsserviço de Blog (dono da tabela de posts)
# -----------------------------------------------------------------------------
# Porta HTTP em que o ms-blog escuta
BLOG_SERVICE_PORT=3002
# Arquivo SQLite que pertence SOMENTE ao ms-blog (caminho relativo à pasta do serviço)
BLOG_DB_PATH=./data/ms-blog.sqlite

# -----------------------------------------------------------------------------
# Comunicação ms-blog -> ms-users (HTTP síncrono)
# -----------------------------------------------------------------------------
# URL base do ms-users, usada pelo cliente HTTP do ms-blog
USERS_SERVICE_URL=http://localhost:3001
# Tempo máximo, em milissegundos, para aguardar a resposta do ms-users
USERS_SERVICE_TIMEOUT_MS=3000
